# PostgreSQL connection (docker compose up -d, or `npm run db:local` for an embedded dev server)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/metidja?schema=public"

# Secret used to sign session JWTs — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Public site URL (used for SEO metadata / sitemap)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Seed admin account (only used by `npm run db:seed`)
SEED_ADMIN_EMAIL="admin@clinique-metidja.dz"
SEED_ADMIN_PASSWORD="ChangeMe!2026"
